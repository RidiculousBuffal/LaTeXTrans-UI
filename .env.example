APP_NAME=LaTeXTrans Backend
APP_VERSION=0.1.0
API_PREFIX=/api
ENVIRONMENT=development

OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional: if set, this takes precedence over MYSQL_* below
BACKEND_DATABASE_URL=

MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=latex_trans
MYSQL_POOL_RECYCLE=1800

MINIO_URL=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_TASKS=latex-trans-tasks
MINIO_SECURE=false

BABELDOC_BIN=babeldoc
BABELDOC_QPS=20
BABELDOC_POOL_MAX_WORKERS=20
BABELDOC_OUTPUT_SUBDIR=babeldoc

TASK_WORKSPACE_ROOT=runtime/tasks
UPLOAD_TMP_ROOT=runtime/uploads
MAX_UPLOAD_BYTES=262144000
DEFAULT_SOURCE_LANGUAGE=en
DEFAULT_TARGET_LANGUAGE=ch
DEFAULT_CREATED_BY=internal-user

# JSON array string is recommended when overriding in real .env
# Example: ["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
