APP_NAME=LaTeXTrans Backend
APP_VERSION=0.1.0
API_PREFIX=/api
ENVIRONMENT=development

OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional: if set, this takes precedence over MYSQL_* below
BACKEND_DATABASE_URL=

MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=latex_trans
MYSQL_POOL_RECYCLE=1800

MINIO_URL=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_TASKS=latex-trans-tasks
MINIO_SECURE=false
ARTIFACT_DOWNLOAD_URL_EXPIRE_SECONDS=600

BABELDOC_BIN=babeldoc
BABELDOC_QPS=20
BABELDOC_POOL_MAX_WORKERS=20
BABELDOC_OUTPUT_SUBDIR=babeldoc

TASK_WORKSPACE_ROOT=runtime/tasks
UPLOAD_TMP_ROOT=runtime/uploads
MAX_UPLOAD_BYTES=262144000
UPLOAD_STREAM_CHUNK_BYTES=1048576
DEFAULT_SOURCE_LANGUAGE=en
DEFAULT_TARGET_LANGUAGE=ch
DEFAULT_CREATED_BY=internal-user

# JSON array string is recommended when overriding in real .env
# Example: ["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Auth / session
# In production, use a strong random secret with at least 32 characters.
JWT_SECRET_KEY=dev-insecure-local-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=latextrans_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_REGISTER_ENABLED=false

# Admin bootstrap
# Keep disabled in production. If enabled, set a unique username and a strong password.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_TASKS_BYPASS_QUOTA=true
DEFAULT_USER_TRANSLATION_QUOTA=0

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_TASK_CREATE_LIMIT=20
RATE_LIMIT_TASK_CREATE_WINDOW_SECONDS=3600

# Production checklist
# 1. Set ENVIRONMENT=production
# 2. Replace JWT_SECRET_KEY with a strong secret
# 3. Set AUTH_COOKIE_SECURE=true
# 4. Set CORS_ORIGINS to your exact frontend domains
# 5. Keep AUTH_REGISTER_ENABLED=false unless you add stronger controls
# 6. Keep ADMIN_BOOTSTRAP_ENABLED=false after first-use bootstrap
